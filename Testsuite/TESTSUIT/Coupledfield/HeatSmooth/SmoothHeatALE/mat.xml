<?xml version="1.0" encoding="utf-8"?>
<cfsMaterialDataBase xmlns="http://www.cfs++.org/material">

  <material name="iron">

    <smooth>
      <elasticity>
        <linear>
          <isotropic>
            <elasticityModulus>
              <real>1.0</real>
            </elasticityModulus>
            <poissonNumber>
              <real>0.0</real>
            </poissonNumber>
          </isotropic>
        </linear>
      </elasticity>
    </smooth>

    <heatConduction>

      <density>
        <linear>
          <real>1</real>
        </linear>
      </density>

      <heatCapacity>
        <linear>
          <real>1</real>
        </linear>
      </heatCapacity>

      <heatConductivity>
        <linear>
          <isotropic>
            <real>1</real>
          </isotropic>
        </linear>
      </heatConductivity>

    </heatConduction>

  </material>

</cfsMaterialDataBase>