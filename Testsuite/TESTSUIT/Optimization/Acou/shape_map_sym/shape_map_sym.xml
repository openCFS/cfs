<cfsSimulation xmlns="http://www.cfs++.org/simulation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.cfs++.org/simulation  https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">
    
    <documentation>
        <title>Acoustic Optimization - Symmetric Shape-Mapping</title>
        <authors>
            <author>Felix Huber</author>
        </authors>
        <date>2026-08-04</date>
        <description>This file solves the crossover problem in a 4-port cavity.
            We use symmteric shape-mapping, with a custom symmetry plane on the origin.
        </description>
    </documentation>
    
    <fileFormats>
        <input>
            <hdf5 fileName="shape_map_sym.h5ref"/>
        </input>
        <output>
            <hdf5 />
        </output>
        <materialData file="mat.xml"/>
    </fileFormats>

    <domain geometryType="plane">
        <regionList>
            <region name="S_opt" material="air"/>
            <region name="S_acou" material="air"/>
        </regionList>
    </domain>

    <sequenceStep index="1">
        <analysis>
            <harmonic>
                <numFreq>1</numFreq>
                <startFreq>1000</startFreq>
                <stopFreq>1000</stopFreq>
                <sampling>linear</sampling>
            </harmonic>
        </analysis>
        <pdeList>
            <acoustic formulation="acouPressure">
                <regionList>
                    <region name="S_acou" complexFluid="yes"/>
                    <region name="S_opt" complexFluid="yes"/>
                </regionList>
                <dampingList>
                    <pml id="pml">
                        <type> inverseDist </type>
                        <dampFactor> 1 </dampFactor>
                    </pml>
                </dampingList>
                <bcsAndLoads>
                    
                </bcsAndLoads>
                <storeResults>
                    <nodeResult type="acouPressure">
                        <allRegions/>
                    </nodeResult>
                    <elemResult type="physicalPseudoDensity">
                        <allRegions/>
                    </elemResult>
                    <elemResult type="optResult_1">
                        <allRegions/>
                    </elemResult>
                    <elemResult type="optResult_2">
                        <allRegions/>
                    </elemResult>
                </storeResults>
            </acoustic>
        </pdeList>
    </sequenceStep>
    <optimization>
         <costFunction type="slack" task="minimize" multiple_excitation="true">
            <multipleExcitation>
                <excitations>
                    <excitation>
                        <normalVelocity name="L_wg_right_surf" value="-0.004836960936382358"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_left_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_top_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_right_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_bot_surf"/>
                    </excitation>
                     <excitation>
                        <normalVelocity name="L_wg_top_surf" value="-0.004836960936382358"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_left_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_top_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_right_surf"/>
                        <absorbingBCs volumeRegion="S_acou" name="L_wg_bot_surf"/>
                    </excitation>
                </excitations>
            </multipleExcitation>
        </costFunction>

        
        <constraint type="dynamicOutputTracking" parameter="1" mode="constraint" bound="upperBound" value="slack" excitation="0">
            <output><acoustic name="L_wg_left" value="1"/></output></constraint>
        <constraint type="dynamicOutputTracking" parameter="1" mode="constraint" bound="upperBound" value="slack" excitation="1">
            <output><acoustic name="L_wg_bot" value="1"/></output></constraint>

        <constraint type="curvature" bound="upperBound" value="0.04/ny" design="node" linear="true" />
        <constraint type="curvature" bound="upperBound" value="0.04/ny" design="profile" linear="true" />
        <constraint type="volume" mode="observation" access="physical"/>

        <optimizer type="ipopt" maxIterations="20" >
            <ipopt>
                <option type="real" name="tol" value="1e-3" />
                <!--<option type="string" name="derivative_test" value="first-order" />
                <option type="string" name="derivative_test_print_all" value="yes" />-->
            </ipopt>
        </optimizer>

        <ersatzMaterial region="S_opt" material="acoustic" method="shapeMap">
            <designSpace local_element_cache="false"/>
            <shapeMap beta="256" shape="tanh" overlap="tanh_sum" enforce_bounds="true" sensitivity="1e-6" integration_order="8" >
                <node dof="x" lower="-0.12" initial="-0.05" upper="0.02" diagonal_sym="mirror" bottom_up_sym="mirror" left_right_sym="mirror" sym_plane="0.0"/>
                <node dof="x" fixed="0" diagonal_sym="mirror" bottom_up_sym="mirror" />
                <profile initial="0.01" lower="0.005" upper="0.1"/>
            </shapeMap>

            <design name="density" initial="0.5" lower="1e-9" upper="1" />
            <design name="slack" initial="0.5" lower="0" upper="2"/>

            <transferFunction type="simp" application="acoustic" param="1"/>
            
            <export save="last" write="iteration"/>
        </ersatzMaterial>

            
        <commit mode="each_forward" stride="10"/>
    </optimization>
</cfsSimulation>