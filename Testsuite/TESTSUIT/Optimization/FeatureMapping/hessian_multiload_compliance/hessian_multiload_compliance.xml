<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/simulation
https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">

  <documentation>
    <title>Multiload feature mapping compliance with the complete exact Hessian from C++</title>
    <authors>
      <author>Fabian Wein</author>
    </authors>
    <date>2026-08-01</date>
    <references>python_hessian_compliance (single load)</references>
    <isVerified>no</isVerified>
    <description>
      Cantilever compliance minimization with two weighted load cases (multiple excitations with
      fixed weights 1.0/0.5, normalized to 2/3 and 1/3) on a feature mapping design of three pills.
      
      The exact Hessian is computed in C++ and passed to the Python optimizer.
      The finite difference check is performed in Python. Alternatively we could use the native Hessian IPOPT (see hessian_compliance)
    </description>
  </documentation>

  <fileFormats>
    <input>
      <regular geometryType="plane" region="mech">
        <box xMax="1.0" yMax="1.0"/>
        <elements nx="16"/>
      </regular>
    </input>
    <output>
      <hdf5/>
      <info/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="plane">
    <regionList>
      <region material="99lines" name="mech"/>
    </regionList>
  </domain>

  <sequenceStep index="1">
    <analysis>
      <static/>
    </analysis>

    <pdeList>
      <mechanic subType="planeStress">
        <regionList>
          <region name="mech"/>
        </regionList>

        <!-- clamped left edge; the loads come from the excitations in the optimization part -->
        <bcsAndLoads>
           <fix name="left">
              <comp dof="x"/>
              <comp dof="y"/>
           </fix>
        </bcsAndLoads>
        <storeResults>
          <elemResult type="mechPseudoDensity">
            <allRegions/>
          </elemResult>
        </storeResults>
      </mechanic>
    </pdeList>
  </sequenceStep>

  <optimization>
    <!-- weighted sum of the two load cases; the weights are normalized internally (2/3, 1/3).
         Verified: J = 2/3 J_1 + 1/3 J_2 reproduces the two single load runs exactly -->
    <costFunction type="compliance" task="minimize" multiple_excitation="true">
      <multipleExcitation>
        <excitations>
          <excitation weight="1.0">
            <force name="bottom_right">
              <comp dof="y" value="-1"/>
            </force>
          </excitation>
          <excitation weight="0.5">
            <force name="top_right">
              <comp dof="y" value="-1"/>
            </force>
          </excitation>
        </excitations>
      </multipleExcitation>
    </costFunction>

    <constraint type="volume" bound="upperBound" value="0.35" linear="false"/>

    <!-- we do the FD-check here. See hessian_compliance for native C++ Hessian IPOPT -->
    <optimizer type="python" maxIterations="3">
      <python file="hessian_scipy.py" path="cfs:share:python">
        <option key="fd_check" value="true"/>
        <option key="gtol" value="1e-4"/>
        <option key="initial_tr_radius" value="0.1"/>
      </python>
    </optimizer>

    <!-- boundary is the C^2 quintic; the exact geometric Hessian needs H'' -->
    <ersatzMaterial region="mech" material="mechanic" method="featureMapping">
      <featureMapping transition="0.1" boundary="quintic" order="3" combine="p-norm" p="3">
        <pill>
          <node dof="x" initial="0.05" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.1"  upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.95" upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.1"  upper="1" lower="0" tip="end"/>
          <profile initial="0.08" lower="0.05" upper="0.25"/>
        </pill>
        <pill>
          <node dof="x" initial="0.05" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.9"  upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.95" upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.15" upper="1" lower="0" tip="end"/>
          <profile initial="0.08" lower="0.05" upper="0.25"/>
        </pill>
        <pill>
          <node dof="x" initial="0.05" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.5"  upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.6"  upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.2"  upper="1" lower="0" tip="end"/>
          <profile initial="0.08" lower="0.05" upper="0.25"/>
        </pill>
      </featureMapping>
      <design name="density" initial=".5" physical_lower="1e-3" upper="1.0"/>

      <transferFunction type="identity" application="mech"/>
      <export save="all" write="iteration"/>
    </ersatzMaterial>
    <commit mode="forward" stride="1"/>
  </optimization>
</cfsSimulation>
