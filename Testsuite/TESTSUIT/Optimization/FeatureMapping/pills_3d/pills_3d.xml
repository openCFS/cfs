<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/simulation
https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">

  <documentation>
    <title>Feature mapping with 3D pills (capsules)</title>
    <authors>
      <author>Fabian Wein</author>
    </authors>
    <date>2026-07-06</date>
    <references>Wein, Dunning, Norato; A review on feature-mapping methods for structural optimization; 2020</references>
    <isVerified>no</isVerified>
    <description>
      Minimal compliance with two 3d pills (capsules).
    </description>
  </documentation>

  <fileFormats>
    <input>
      <!-- 1 x 1 x 0.2 with h=0.1: 10 x 10 x 2 = 200 elements. nz is derived from the box -->
      <regular geometryType="3d" region="mech">
        <box xMax="1" yMax="1" zMax="0.2"/>
        <elements nx="10" />
      </regular>
    </input>
    <output>
      <hdf5/>
      <info/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="3d">
    <regionList>
      <region material="99lines" name="mech"/>
    </regionList>
  </domain>

  <sequenceStep index="1">
    <analysis>
      <static/>
    </analysis>

    <pdeList>
      <mechanic subType="3d">
        <regionList>
          <region name="mech"/>
        </regionList>

        <bcsAndLoads>
           <fix name="left">
              <comp dof="x"/>
              <comp dof="y"/>
              <comp dof="z"/>
           </fix>
           <force name="bottom_right">
             <comp dof="y" value="-1"/>
           </force>
        </bcsAndLoads>
        <storeResults>
          <elemResult type="mechPseudoDensity">
            <allRegions/>
          </elemResult>
          <nodeResult type="mechDisplacement">
            <allRegions/>
          </nodeResult>
        </storeResults>
      </mechanic>
    </pdeList>

    <!-- for realistic 3d problems, choose a good iterative solver, e.g. ginkgo -->
    <!-- <linearSystems>
      <system>
        <solverList>
          <ginkgo/>
        </solverList>
      </system>
    </linearSystems> -->
  </sequenceStep>

  <optimization>
    <costFunction type="compliance" task="minimize">
      <stopping type="designChange" queue="2" value="1e-2"/>
    </costFunction>
    <constraint type="volume" bound="upperBound" value="0.25" mode="constraint" linear="false"/>

    <optimizer type="dumas_gcmma" maxIterations="20"/>

    <ersatzMaterial region="mech" material="mechanic" method="featureMapping">
      <featureMapping transition="0.1" order="4" combine="p-norm" p="4">
        <!-- bottom chord. z is free within the depth, the profile at most fills it (upper = 0.1) -->
        <pill>
          <node dof="x" initial="0.05" lower="0" upper="1"   tip="start"/>
          <node dof="y" initial="0.1"  lower="0" upper="1"   tip="start"/>
          <node dof="z" initial="0.1"  lower="0" upper="0.2" tip="start"/>
          <node dof="x" initial="0.95" lower="0" upper="1"   tip="end"/>
          <node dof="y" initial="0.1"  lower="0" upper="1"   tip="end"/>
          <node dof="z" initial="0.1"  lower="0" upper="0.2" tip="end"/>
          <profile initial="0.08" lower="0.05" upper="0.1"/>
        </pill>
        <!-- diagonal from the upper left towards the load -->
        <pill>
          <node dof="x" initial="0.05" lower="0" upper="1"   tip="start"/>
          <node dof="y" initial="0.9"  lower="0" upper="1"   tip="start"/>
          <node dof="z" initial="0.1"  lower="0" upper="0.2" tip="start"/>
          <node dof="x" initial="0.95" lower="0" upper="1"   tip="end"/>
          <node dof="y" initial="0.15" lower="0" upper="1"   tip="end"/>
          <node dof="z" initial="0.1"  lower="0" upper="0.2" tip="end"/>
          <profile initial="0.08" lower="0.05" upper="0.1"/>
        </pill>
      </featureMapping>
      <design name="density" initial="0.5" physical_lower="1e-3" upper="1.0"/>

      <transferFunction type="identity" application="mech"/>
      <export save="last" write="iteration"/>

    </ersatzMaterial>
    <commit mode="forward" stride="1"/>
  </optimization>
</cfsSimulation>
