<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/simulation
https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">

  <documentation>
    <title>Feature Mapping with the alpha scaling from Geometry Projection</title>
    <authors>
      <author>Fabian Wein</author>
    </authors>
    <date>2026-07-29</date>
    <references>Norato et al. A geometry projection method for continuum-based topology optimization with discrete elements; 2015</references>
    <isVerified>no</isVerified>
    <description>
      The geometry variable alpha_f scales each feature. For the stiffness as alpha^q * rho (q=3) and not penalized
      in the volume via the implicit 'plainAlphaDensity' field.
    </description>
  </documentation>

  <fileFormats>
    <input>
      <regular geometryType="plane" region="mech">
        <elements nx="10" />
      </regular>
    </input>
    <output>
      <hdf5/>
      <info/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="plane">
    <regionList>
      <region material="99lines" name="mech"/>
    </regionList>
    <nodeList>
      <nodes name="load">
        <coord x="1" y="0.5"/>
      </nodes>
    </nodeList>
  </domain>

  <sequenceStep index="1">
    <analysis>
      <static/>
    </analysis>

    <pdeList>
      <mechanic subType="planeStress">
        <regionList>
          <region name="mech"/>
        </regionList>

        <bcsAndLoads>
           <fix name="left">
              <comp dof="x"/>
              <comp dof="y"/>
           </fix>
           <force name="load" >
             <comp dof="y" value="-1"/>
           </force>
        </bcsAndLoads>
        <storeResults>
          <elemResult type="mechPseudoDensity">
            <allRegions/>
          </elemResult>
          <!-- the implicit 'plainAlphaDensity' field of the alpha volume. It is registered by cfs on the
               reserved last slot, so no <result/> is given (and none must use this id) -->
          <elemResult type="optResult_16">
            <allRegions/>
          </elemResult>
        </storeResults>
      </mechanic>
    </pdeList>
  </sequenceStep>

  <optimization>
    <costFunction type="compliance" task="minimize">
      <stopping type="designChange" queue="2" value="1e-2"/>
    </costFunction>

    <!-- the native alpha volume on the implicit field v_e = combine(alpha_f * rho_f) written by the
         mapping. With alpha this has to be stated: design="density" would give the alpha^q volume -->
    <constraint type="volume" field="plainAlphaDensity" bound="upperBound" value="0.5" linear="false"/>

    <!-- prevent the degenerate case P=Q (zero length pill), relevant since alpha allows fading out features -->
    <constraint type="distance" design="node" bound="lowerBound" value="0.05"/>

    <optimizer type="dumas_gcmma" maxIterations="30"/>

    <ersatzMaterial region="mech" material="mechanic" method="featureMapping">
      <featureMapping  transition=".1" order="5" combine="p-norm" p="4" >
        <!-- the general alpha variable for all pills can locally be overwritten. 
             It also works with loading pills with -x without own alpha.
             q is for the stiffness. -->
        <alpha initial="0.5" lower="0" upper="1" q="3"/>
        <pill>
          <node dof="x" initial="0.1" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.2" upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.9" upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.5" upper="1" lower="0" tip="end"/>
          <profile initial="0.1" lower="0.05" upper="0.2" />
        </pill>
        <pill>
          <node dof="x" initial="0.1" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.8" upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.9" upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.5" upper="1" lower="0" tip="end"/>
          <profile initial="0.1" lower="0.05" upper="0.2" />
        </pill>
        <pill>
          <node dof="x" initial="0.1" upper="1" lower="0" tip="start"/>
          <node dof="y" initial="0.45" upper="1" lower="0" tip="start"/>
          <node dof="x" initial="0.9" upper="1" lower="0" tip="end"/>
          <node dof="y" initial="0.55" upper="1" lower="0" tip="end"/>
          <profile initial="0.1" lower="0.05" upper="0.2" />
        </pill>
      </featureMapping>
      <!-- very helpful for alpha, to have lower=0 -->
      <design name="density" initial=".5" lower="0" upper="1.0" groundmaterial="void"/>

      <transferFunction type="identity" application="mech" />
      <export save="last" write="iteration"/>

    </ersatzMaterial>
    <commit mode="forward" stride="1"/>
  </optimization>
</cfsSimulation>
