<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/simulation
https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">

  <documentation>
    <title>Feature mapping with features (pill) from an external file</title>
    <authors>
      <author>Fabian Wein</author>
    </authors>
    <date>2026-08-01</date>
    <references>none</references>
    <isVerified>no</isVerified>
    <description>
      Tests the external feature file mechanism: the horizontal pill is local, the vertical pill
      comes via the external element from external_pills.xml (root element 'features').
    </description>
  </documentation>

  <fileFormats>
    <input>
      <regular geometryType="plane" region="mech">
        <elements nx="10" />
      </regular>
    </input>
    <output>
      <hdf5/>
      <info/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="plane">
    <regionList>
      <region material="99lines" name="mech"/>
    </regionList>
  </domain>

  <sequenceStep index="1">
    <analysis>
      <static/>
    </analysis>

    <pdeList>
      <mechanic subType="planeStress">
        <regionList>
          <region name="mech"/>
        </regionList>

        <bcsAndLoads>
           <fix name="left">
              <comp dof="x"/>
              <comp dof="y"/>
           </fix>
           <force name="right">
             <comp dof="x" value="1"/>
           </force>
        </bcsAndLoads>
        <storeResults>
          <elemResult type="mechPseudoDensity">
            <allRegions/>
          </elemResult>
        </storeResults>
      </mechanic>
    </pdeList>
  </sequenceStep>

  <optimization>
    <costFunction type="compliance" task="minimize" sequence="1" linear="false"/>

    <optimizer type="evaluate" maxIterations="1"/>

    <ersatzMaterial region="mech" material="mechanic" method="featureMapping">
      <featureMapping transition="0.1" order="3" combine="p-norm" p="3">
        <!-- external features come first: the vertical pill -> feature index 0 -->
        <external file="external_pills.xml"/>
        <!-- the local horizontal pill -> feature index 1 -->
        <pill>
          <node dof="x" initial="0.05" lower="0" upper="1" tip="start"/>
          <node dof="y" initial="0.5" lower="0" upper="1" tip="start"/>
          <node dof="x" initial="0.95" lower="0" upper="1" tip="end"/>
          <node dof="y" initial="0.5" lower="0" upper="1" tip="end"/>
          <profile initial="0.15" lower="0.05" upper="0.2"/>
        </pill>
      </featureMapping>
      <design name="density" initial=".5" physical_lower="1e-3" upper="1.0"/>

      <transferFunction type="identity" application="mech"/>
      <export save="all" write="iteration"/>
    </ersatzMaterial>
    <commit mode="forward" stride="1"/>
  </optimization>
</cfsSimulation>
