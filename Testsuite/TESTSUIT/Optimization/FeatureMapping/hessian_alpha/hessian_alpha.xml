<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/simulation
https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">

  <documentation>
    <title>Feature mapping consolidating with the geometry variable alpha and exact Hessians</title>
    <authors>
      <author>Fabian Wein</author>
    </authors>
    <date>2026-07-30</date>
    <references>Wein, Jung, Moradian, Stingl; Gradient-Based Generation of Feature Mapping Initial
                Designs from SIMP Density Fields; 2026 (to be submitted :))</references>
    <isVerified>no</isVerified>
    <description>
      Similar to the alpha_volume test, do we test the geometry projection alpha scaling, here with
      the Hessian and the (poor) scipy optimizer as cyipopt is not available in the pipeline.
      Alternatively we could use the native Hessian IPOPT (see hessian_compliance).
      See the tracking and reward tests and the paper for the problem setup: Two pills shall match the given
      target bulk2d_10.density.xml. One pill is meant to align an become full alpha, the second is fixed so the solution
      is to scale down the second pill's alpha. The constraint is to have a total sum of alpha at about 1.
    </description>
  </documentation>

  <!-- tracking and alpha sum from the reusable share/python kernel -->
  <python file="tracking.py" path="cfs:share:python" />

  <fileFormats>
    <input>
      <hdf5 fileName="hessian_alpha.h5ref"/>
    </input>
    <output>
      <hdf5/>
      <info/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="plane">
    <regionList>
      <region material="99lines" name="mech"/>
    </regionList>
  </domain>

  <sequenceStep index="1">
    <analysis>
      <static/>
    </analysis>

    <pdeList>
      <mechanic subType="planeStress">
        <regionList>
          <region name="mech"/>
        </regionList>

        <!-- bcs are irrelevant, we have no state dependent optimization problem -> cg maxIter=1 -->
        <bcsAndLoads>
           <fix name="left">
              <comp dof="x"/>
              <comp dof="y"/>
           </fix>
           <force name="right">
             <comp dof="x" value="1"/>
           </force>
        </bcsAndLoads>
        <storeResults>
          <elemResult type="mechPseudoDensity">
            <allRegions/>
          </elemResult>
        </storeResults>
      </mechanic>
    </pdeList>

    <!-- dummy FE-Part-->
    <linearSystems>
      <system>
        <solverList>
          <cg>
            <maxIter>1</maxIter>
          </cg>
        </solverList>
      </system>
    </linearSystems>
  </sequenceStep>

  <optimization>
    <costFunction type="python" task="minimize" design="density">
      <python name="track" init="track_init" eval="track_eval" grad="track_grad" curvature="track_curvature" script="kernel">
        <option key="target" value="bar_10.density.xml"/>
      </python>
    </costFunction>

    <constraint type="python" value="1.01" bound="upperBound" access="plain"  design="density">
      <python name="alpha_sum" eval="alpha_sum_eval" grad="alpha_sum_grad" curvature="alpha_sum_curvature" script="kernel"/>
    </constraint>

    <!-- prevent the degenerate case P=Q (zero length pill) when a pill fades out -->
    <constraint type="distance" design="node" bound="lowerBound" value="0.05"/>

    <optimizer type="python" maxIterations="10">
      <python file="hessian_scipy.py" path="cfs:share:python">
        <option key="fd_check" value="false"/>
        <option key="gtol" value="1e-2"/>
        <option key="xtol" value="1e-2"/>
      </python>
    </optimizer>

    <!-- boundary is the C^2 quintic; the exact geometric Hessian needs H'' (poly is only C^1) -->
    <ersatzMaterial region="mech" material="mechanic" method="featureMapping">
      <featureMapping transition="0.1" boundary="quintic" order="5" combine="p-norm" p="3" hessexport="true">
        <!-- per-pill initial overrides below break the compensation symmetry -->
        <alpha initial=".8" lower="0" upper="1" q="1"/> 
        <pill>
          <node dof="x" initial="0.05" lower="0" upper="1" tip="start"/>
          <node dof="y" initial="0.55" lower="0" upper="1" tip="start"/>
          <node dof="x" initial="0.95" lower="0" upper="1" tip="end"/>
          <node dof="y" initial="0.55" lower="0" upper="1" tip="end"/>
          <profile initial="0.15" lower="0.1" upper="0.2"/>
        </pill>
        <pill>
          <node dof="x" fixed="0.5" tip="start"/>
          <node dof="y" fixed="0.2" tip="start"/>
          <node dof="x" fixed="0.5" tip="end"/>
          <node dof="y" fixed="0.55" tip="end"/>
          <profile fixed=".1" />
          <alpha initial="0.5" lower="0" upper="1"/>
        </pill>
      </featureMapping>
      <design name="density" initial=".5" lower="1e-3" upper="1.0"/>

      <transferFunction type="identity" application="mech"/>
      <export save="last" write="iteration"/>
    </ersatzMaterial>
    <commit mode="forward" stride="1"/>
  </optimization>
</cfsSimulation>
