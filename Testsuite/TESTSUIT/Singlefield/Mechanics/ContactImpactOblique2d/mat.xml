<?xml version='1.0' encoding='utf-8'?>
<cfsMaterialDataBase xmlns="http://www.cfs++.org/material">
  <!-- Aluminium, with a REAL Poisson ratio this time. Most contact testcases in the suite set
       it to zero to keep a pressure distribution smooth; here nothing asserts a distribution,
       the invariant is momentum, and an impact is a wave problem in which the lateral coupling
       is part of the physics. Density is what makes the model dynamic at all. -->
  <material name="Aluminium">
    <mechanical>
      <density>
        <linear>
          <real> 2700 </real>
        </linear>
      </density>
      <elasticity>
        <linear>
          <isotropic>
            <elasticityModulus>
              <real> 7.00E+10 </real>
            </elasticityModulus>
            <poissonNumber>
              <real> 0.33 </real>
            </poissonNumber>
          </isotropic>
        </linear>
      </elasticity>
    </mechanical>
  </material>
</cfsMaterialDataBase>
