<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.cfs++.org/simulation ../../../../../share/xml/CFS-Simulation/CFS.xsd"
               xmlns="http://www.cfs++.org/simulation">

  <documentation>
    <title>Contact gap tracks a prescribed displacement</title>
    <authors><author>kroppert</author></authors>
    <date>2026-08-05</date>
    <keywords><keyword>contact</keyword></keywords>
    <references>none</references>
    <isVerified>no</isVerified>
    <description>
      The bodies start 0.1 apart. The whole secondary surface is given a prescribed displacement
      of -0.15 in z, so the gap must close by exactly that amount: 0.1 - 0.15 = -0.05. The
      initial (reference) report must still read 0.1 with no active points; the post-solve
      "deformed" report must read -0.05 with all four points active.
    </description>
  </documentation>

  <fileFormats>
    <input>
      <hdf5 fileName="ContactPrescribedGap3d.h5" linearizeEntities="__none__"/>
    </input>
    <output><hdf5/></output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="3d">
    <regionList>
      <region name="master_elem" material="Aluminium"/>
      <region name="slave_elem" material="Aluminium"/>
    </regionList>
    <surfRegionList>
      <surfRegion name="master_iface"/>
      <surfRegion name="slave_iface"/>
      <surfRegion name="top"/>
      <surfRegion name="bottom"/>
    </surfRegionList>
  </domain>

  <fePolynomialList>
    <Lagrange><gridOrder/></Lagrange>
  </fePolynomialList>

  <integrationSchemeList>
    <scheme>
      <method>Gauss</method>
      <order>4</order>
      <mode>absolute</mode>
    </scheme>
  </integrationSchemeList>

  <sequenceStep>
    <analysis><static/></analysis>

    <pdeList>
      <mechanic subType="3d">
        <regionList>
          <region name="master_elem"/>
          <region name="slave_elem"/>
        </regionList>

        <contactList>
          <contactPair name="cube_contact"
                       primarySurface="master_iface"
                       secondarySurface="slave_iface"
                       slidingType="small"
                       applyContactForce="no"
                       normalPenalty="100"
                       initialGapHandling="fromMesh"
                       integrationOrder="2"/>
        </contactList>

        <bcsAndLoads>
          <!-- lower body held; with no load its displacement stays zero -->
          <fix name="bottom">
            <comp dof="x"/><comp dof="y"/><comp dof="z"/>
          </fix>
          <!-- the entire secondary surface is moved down by 0.15 -->
          <displacement name="slave_iface">
            <comp dof="x" value="0"/>
            <comp dof="y" value="0"/>
            <comp dof="z" value="-0.15"/>
          </displacement>
        </bcsAndLoads>

        <storeResults>
          <nodeResult type="mechDisplacement"><allRegions/></nodeResult>
        </storeResults>
      </mechanic>
    </pdeList>

    <linearSystems>
      <system>
        <solutionStrategy>
          <standard>
            <setup idbcHandling="penalty"/>
            <matrix storage="sparseNonSym" reordering="noReordering"/>
          </standard>
        </solutionStrategy>
        <solverList><directLU/></solverList>
      </system>
    </linearSystems>

  </sequenceStep>
</cfsSimulation>
