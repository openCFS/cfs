<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.cfs++.org/simulation">
  <documentation>
    <title>Transient 2D Heat PDE with ALE grid velocity</title>
    <authors>
      <author>Nikolaus Stoecher</author>
    </authors>
    <date>2026-08-06</date>
    <keywords>
      <keyword>heatConduction</keyword>
    </keywords>
    <references></references>
    <isVerified>yes</isVerified>
    <description>
      Transient two-dimensional heat conduction test with a prescribed
      grid velocity. The test verifies the ALE transport term
      -rho*c_p*v_g*grad(T) in HeatPDE. The case is numerically equivalent
      to convection with the opposite physical transport velocity.
    </description>
  </documentation>
  <fileFormats>
    <input>
      <hdf5 fileName="mesh/mesh.h5"/>
    </input>
    <output>
      <hdf5/>
      <text id="txt"/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="plane">
    <regionList>
      <region name="S_inner" material="iron"/>
    </regionList>
    <surfRegionList>
      <surfRegion name="left"/>
      <surfRegion name="right"/>
      <surfRegion name="bottom"/>
      <surfRegion name="top"/>
    </surfRegionList>
    <nodeList>
      <nodes name="source">
        <coord x="0" y="0"/>
      </nodes>
    </nodeList>
  </domain>


  <sequenceStep index="1">
    <analysis>
<!--      <static/>-->
      <transient>
        <numSteps>10</numSteps>
        <deltaT>0.1</deltaT>
      </transient>
    </analysis>

    <pdeList>
      <heatConduction>
        <regionList>
          <region name="S_inner" movingMeshId="gridVelocity"/>
        </regionList>

       <movingMeshList>
        <movingMesh name="gridVelocity">
          <comp dof="x" value="-0.1"/>
          <comp dof="y" value="0.0"/>
        </movingMesh>
      </movingMeshList>

        <bcsAndLoads>
          <heatFlux name="bottom" value="0"/>
          <heatFlux name="top" value="0"/>
          <heatFlux name="right" value="0"/>
          <temperature name="left" value="1"/>
        </bcsAndLoads>

        <storeResults>
          <nodeResult type="heatTemperature">
            <allRegions/>
          </nodeResult>
          <elemResult type="heatFluxDensity">
            <allRegions/>
          </elemResult>
        </storeResults>
      </heatConduction>
    </pdeList>


    <linearSystems>
      <system>
        <solutionStrategy>
          <standard>

            <matrix storage="sparseNonSym"/>
          </standard>
        </solutionStrategy>
        <solverList>
              <pardiso/>
                </solverList>
      </system>
    </linearSystems>
  </sequenceStep>
</cfsSimulation>
